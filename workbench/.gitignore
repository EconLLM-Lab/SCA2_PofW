# uv-managed virtual environment — never commit
.venv/

# python bytecode / caches
__pycache__/
*.py[cod]
.pytest_cache/

# build artifacts (the wheel carries src/sca2_workbench)
build/
dist/
*.egg-info/

# local capture exports (float tensors of local runs; never commit)
exports/

# trained adapters (slice 3a) — local only, never commit
models/

# screenshots: keep only the curated final set (iterations stay local)
design/layout-v2/shots/
viewer/screens/**/*.png
!viewer/screens/v2/final/*.png
design/layout-v3/shots/
!viewer/screens/v3/final/*.png

# verifier iteration folders (local evidence; the curated record is plans/*_VERIFICATION.md). Anchored to this dir.
/viewer/screens/sca2/verified/
/viewer/screens/sca2/wb3v/
/viewer/screens/sca2/wb31v/
/viewer/screens/sca2/wb4v/
/analysis/out/w3v_*
